# DATABASE_BACKUP_DIR=/home/ubuntu/molgian-bureau-backups
# ALLOW_UNSAFE_REPO_DB_PATH=false
NODE_ENV=development
REGISTER_GLOBAL_COMMANDS=false
ADMIN_USER_IDS=
ALLOW_SERVER_ADMINS=false
