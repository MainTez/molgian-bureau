DISCORD_TOKEN=your-discord-bot-token
GUILD_ID=your-dev-guild-id
TIMEZONE=Europe/Oslo
EVENT_CHANNEL_NAME=Special Place
FANDOM_WIKI_BASE_URL=https://www.fandom.com
